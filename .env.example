# Copy to .env and adjust per machine. Never commit .env.

# Lab network (VMware VMnet1 host-only)
LAB_SUBNET=10.10.10.0/24
HOST_IP=10.10.10.1
KALI_IP=10.10.10.10
# Second attacker address for the two-attacker test (eval/run_dual.py). Add it on Kali once, by hand, not persistent: sudo ip addr add 10.10.10.11/24 dev eth0
KALI_IP2=10.10.10.11

# tshark capture interface (find yours with: tshark -D, look for "VMware Network Adapter VMnet1")
# This ID differs per machine.
CAPTURE_IFACE=\Device\NPF_{REPLACE-WITH-YOUR-GUID}

# Docker's internal network for the honeypot containers (not the attacker network).
# Cowrie logs the gateway (.1 of this subnet) as src_ip because Docker relays connections.
# If `docker compose up` says "Pool overlaps", change this to another unused range.
DOCKER_LAB_SUBNET=172.30.0.0/24

# Optional: pcap output folder and a tshark capture filter (BPF), e.g. "net 10.10.10.0/24"
#CAPTURE_DIR=capture/pcaps
#CAPTURE_FILTER=

# Honeypot published ports (bound to HOST_IP only)
COWRIE_SSH_PORT=2222
WEB_PORT=8080
FTP_PORT=21
TELNET_PORT=23
SMB_PORT=4445

# Decoys spawned by the controller appear as NEW hosts on VMnet1 using this IP pool.
# Run lab/add_decoy_ips.ps1 once per machine (administrator PowerShell) to add them to the host adapter.
DECOY_IP_FIRST=10.10.10.20
DECOY_IP_LAST=10.10.10.29
# Internal Docker network for spawned decoys (separate from DOCKER_LAB_SUBNET).
DECOY_DOCKER_SUBNET=172.31.0.0/24

# Benign traffic generator ("workstation" VM on VMnet1, separate from Kali). See README, "Benign traffic".
WORKSTATION_IP=10.10.10.30
WORKSTATION_USER=changeme
# Lab-only demo account the generator uses to log in to the Cowrie honeypot like a normal user.
GEN_SSH_USER=jsmith
GEN_SSH_PASSWORD=changeme

# Host -> Kali SSH (lets the host start attacks without typing passwords). See README "Automated attacks".
KALI_USER=kali
# Private key for that login, created once with ssh-keygen. Lives outside the repo; never commit it.
KALI_SSH_KEY=~/.ssh/lab_kali

# Model the Claude analysis runs on (passed to `claude --model`). Pinned so campaign results can be attributed to one model; the model ids the
# CLI actually used are stored in each run's analysis_meta.json. Leave empty to use the claude CLI's own default.
ANALYSIS_MODEL=claude-sonnet-5-5
